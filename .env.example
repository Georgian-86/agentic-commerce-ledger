# ============================================================
#  Agentic Commerce Ledger — environment config
#  Everything here has a $0 option. See README "Cost".
# ============================================================

# ---- LLM (agent brain) ----
# Option A — recommended: Groq's free API, open-weight models, no
# credit card, OpenAI-compatible, fast enough for a live demo.
# Free key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Hosted model catalogues change without notice — the model this
# project was first built against was retired mid-build. If the primary
# 404s, the client walks this list rather than failing the demo.
LLM_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
LLM_TIMEOUT_MS=30000

# Option B — fully local, zero network dependency.
#   ollama pull llama3-groq-tool-use
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3-groq-tool-use

# ---- Razorpay (test mode is free) ----
# Dashboard → Account & Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Set when you configure a webhook in the Razorpay dashboard
# (Settings → Webhooks, event: payment_link.paid). Falls back to the
# key secret if unset, which is fine for local rehearsal.
RAZORPAY_WEBHOOK_SECRET=

# ---- Trust layer ----
# Ed25519 keypairs for the user / merchant / agent roles are generated
# into commerce-agent/data/keys.json on first boot. Nothing to set here.
#
# Orders above this need an explicit human approval — via the dashboard
# button, or via MCP elicitation for an external agent. An agent can
# never self-approve past it.
CONFIRMATION_THRESHOLD_PAISE=150000

# ---- Ports & URLs ----
CATALOG_SERVER_PORT=4100
COMMERCE_AGENT_PORT=4200
CATALOG_SERVER_URL=http://localhost:4100/mcp
PUBLIC_BASE_URL=http://localhost:4200

# ---- Demo safety ----
# true → Razorpay network calls are replaced with mocks of the same
# shape. Signature verification, gating, ledger holds and audit writes
# all still run for real, and the console labels itself DEMO MODE
# throughout so a mocked call is never passed off as a real one.
DEMO_MODE=false
