# ============================================================
#  Production env — copy to .env, fill in the three secrets.
#  (Local dev uses the fuller .env.example instead.)
# ============================================================

# ---- runtime ----
NODE_ENV=production
# PORT is injected by most hosts (Render, Railway, Fly via fly.toml).
# Set it only for a bare VPS / docker run.
PORT=4200
HOST=0.0.0.0

# One process runs the catalog MCP server in-process. Leave this true
# unless you are deploying catalog-server separately.
EMBED_CATALOG=true

# The origin browsers and Razorpay will actually reach. REQUIRED for real
# payments — the redirect callback URL is built from it and won't verify
# if it's wrong. Render/Railway derive it automatically; set it yourself
# on Fly / a VPS, e.g. https://agentic-bazaar.fly.dev
PUBLIC_BASE_URL=

# Persist the hash-chained ledger + Ed25519 keys across restarts by
# pointing this at a mounted volume. Omit for ephemeral (demo-fine).
ACL_DATA_DIR=/data

# ---- LLM (Groq free tier) ----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
LLM_API_KEY=              # <-- your Groq key

# ---- Razorpay test mode ----
RAZORPAY_KEY_ID=          # <-- rzp_test_...
RAZORPAY_KEY_SECRET=      # <-- test key secret
# From Razorpay Dashboard → Settings → Webhooks, after you add the
# webhook pointing at  <PUBLIC_BASE_URL>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---- trust layer ----
CONFIRMATION_THRESHOLD_PAISE=150000

# ---- demo safety ----
# true  -> Razorpay network calls are mocked (signature checks, gating,
#          ledger and audit all still run for real). Start here.
# false -> real test-mode Razorpay. Flip once the keys above are set and
#          the webhook is configured.
DEMO_MODE=true
